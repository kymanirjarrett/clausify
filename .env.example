# Template for environment variables. Copy to .env and fill in real values.
# .env is gitignored. Never commit real credentials.
# Local development needs none of these: application-local.yml has working defaults.

# Spring profile. Use "prod" on Render; leave unset locally (defaults to "local").
SPRING_PROFILES_ACTIVE=prod

# Full JDBC URL from the Aiven console, including its SSL parameters.
DB_URL=jdbc:mysql://your-service.aivencloud.com:12345/defaultdb?sslMode=REQUIRED
# Aiven database user.
DB_USERNAME=avnadmin
# Aiven database password.
DB_PASSWORD=change-me

# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_change-me
# Groq model name; change here when Groq retires a model.
GROQ_MODEL=openai/gpt-oss-120b

# Secret used to sign JWTs. At least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me
# Comma-separated origins allowed to call the API (the Vercel frontend URL).
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: host port for the Docker MySQL (docker-compose.yml). Defaults to 3307.
# MYSQL_PORT=3307
