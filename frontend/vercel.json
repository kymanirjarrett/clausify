{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://clausify-api.onrender.com/api/:path*" },
    { "source": "/swagger-ui.html", "destination": "https://clausify-api.onrender.com/swagger-ui.html" },
    { "source": "/swagger-ui/:path*", "destination": "https://clausify-api.onrender.com/swagger-ui/:path*" },
    { "source": "/v3/api-docs/:path*", "destination": "https://clausify-api.onrender.com/v3/api-docs/:path*" },
    { "source": "/v3/api-docs", "destination": "https://clausify-api.onrender.com/v3/api-docs" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
